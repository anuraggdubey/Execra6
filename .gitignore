# Execra Git Ignore Rules
# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Test and coverage output
/coverage

# Next.js and production builds
/.next/
/out/
/build
.turbo/

# Generated app output
/projects/
/public/browser-agent/
/.artifacts/

# Environment files and secrets
.env
.env.*
env.example
.env.local
.env.mainnet
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env*.example
.env*.local
*.secret
*.secrets
*.secret.*
*.secrets.*
secrets/
.secrets/
credentials/
.credentials/
service-account*.json
*-service-account.json
*private-key*
*secret-key*
*seed*

# Local credential/config files
.npmrc
.envrc
.direnv/

# Certificates and keys
*.pem
*.key
*.pub
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Logs and local diagnostics
*.log
*.out
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
build_output.log
ts_error.txt

# Temporary files
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*~

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Deployment
.vercel/

# Supabase local state
supabase/.temp/
supabase/.branches/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Soroban / Stellar smart contract artifacts
contracts/**/target/
contracts/**/*.wasm
contracts/**/*.d
.soroban/
.stellar/

# Local-only chain deployment manifests and transaction files
contracts.*.local.json
contracts.local.json
tmp*.xdr
*.xdr
*.tx
*.txn
*.soroban.json

# Stale test files
test-rpc.js

# Gemini IDE
.gemini/

# Misc
feedback doc/
